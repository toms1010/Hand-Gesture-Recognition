#!/usr/bin/env bash
# Launch the hand-gesture app with the project venv when available.
set -euo pipefail
cd "$(dirname "$0")"
if [ -x ".venv/bin/python" ]; then
  exec ".venv/bin/python" src/main.py "$@"
elif [ -x ".venv-1/bin/python" ]; then
  exec ".venv-1/bin/python" src/main.py "$@"
else
  exec python3 src/main.py "$@"
fi
